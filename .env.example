# Copy to .env. Run: node scripts/setup-local.mjs (generates local passwords).
NODE_ENV=development
# Required for admin MFA and encrypted provider overrides: exactly 64 random hex characters.
# Generate in a secure operator terminal; back up securely and never commit the value.
# Without this key, normal env-based providers still work but admin MFA enrollment is disabled.
ADMIN_SECRETS_MASTER_KEY=
HOST=127.0.0.1
PORT=3001
APP_URL=http://localhost:5173
# Portable URL priority: Admin override > PUBLIC_* env > legacy APP_URL (app only).
# Empty public-site URL falls back to the application only in development.
# Open exactly PUBLIC_APP_URL / APP_URL for social sign-in (localhost and 127.0.0.1 have separate cookies).
PUBLIC_SITE_URL=
PUBLIC_APP_URL=
# Server-only social authentication. Google Maps keys are unrelated to Google OAuth.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS8 .p8 contents; quoted escaped \n newlines are supported. Prefer encrypted Admin storage.
APPLE_PRIVATE_KEY=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_SOCKET=
MYSQL_DATABASE=tripsync
MYSQL_USER=tripsync
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
UPLOAD_DIR=.local/uploads

# Optional AI. Set model IDs available in your API account.
# OPENAI_MODEL must support Responses API, web_search and structured JSON.
# PDF/image reservation extraction also needs PDF input and vision support.
# Current local model was verified with live requests; keep your working model ID.
# OPENAI_IMAGE_MODEL must support /images/generations with base64 output.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=

# Backend only. Enable Places API (New) and Time Zone API in Google Cloud.
# Restrict this key to those APIs and to the backend's outbound IP in production.
# Do not use HTTP-referrer restrictions for this server key. No VITE_* key is needed.
GOOGLE_MAPS_API_KEY=
## Optional: Chrome executable on the backend, used for A4 PDF exports.
## Windows defaults to C:/Program Files/Google/Chrome/Application/chrome.exe
CHROME_PATH=

# Full Travel Book only: server-side geographic PNG maps (never Google imagery).
# Create a project/key at https://myprojects.geoapify.com/; Free plan allows commercial
# use within its quota with attribution. Restrict the key by backend outbound IP.
# Leave blank until your account/key is configured. No VITE_* key is required.
GEOAPIFY_PDF_MAPS_API_KEY=
# Private persistent Full Book map cache, outside public/dist and Wallet uploads.
# Keep this directory on persistent disk; share it between backend workers.
PDF_STATIC_MAP_CACHE_DIR=.local/pdf-static-maps

# Private backend file; never put it in public/ or src/. See docs/PHASE_4.md.
REFERRAL_LINKS_FILE=.local/referrals.json

# Development without SMTP writes messages to .local/mail.
# Production requires SMTP plus valid HTTPS public-site and application URLs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TripSync <noreply@example.com>
# Set to 1 only when Express is behind exactly one trusted reverse proxy.
TRUST_PROXY=0

# Stripe-hosted Checkout and Portal. Keep both switches off until staging passes.
# Prefer Admin encrypted credential storage; never expose Stripe secrets to Vite.
BILLING_ENABLED=false
BILLING_PROVIDER=stripe
BILLING_ENFORCEMENT_ENABLED=false
BILLING_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TRIP_PACK_5=
STRIPE_PRICE_TRIP_PACK_10=
STRIPE_PRICE_TRIP_PACK_20=
# Set the validated bpc_ configuration in Admin > Billing (cancel at period end).
# PayPal through Stripe stays off until account eligibility/recurring approval is verified.

# Storage: server only. Choose local or bunny explicitly (blank defaults to local).
STORAGE_PROVIDER=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_REGION=
# Public marketing CDN; never used for private Wallet access.
BUNNY_PUBLIC_CDN_BASE=
# Public intro video HTTPS URL, embedded by Vite during build.
VITE_INTRO_VIDEO_URL=

# Interactive Trip Maps: dedicated PUBLIC browser key, never the server Places key.
# Restrict by HTTP referrer to your exact app origins, and by API to Maps JavaScript API.
# Maps JavaScript API requires activation/billing in Google Cloud. See docs/INTERACTIVE_TRIP_MAPS.md.
GOOGLE_MAPS_BROWSER_KEY=

# Before You Go only: persistent rolling 24-hour AI-attempt limits, server-side.
ESSENTIALS_MAX_UPDATES_PER_TRIP_24H=2
ESSENTIALS_MAX_UPDATES_PER_USER_24H=20
