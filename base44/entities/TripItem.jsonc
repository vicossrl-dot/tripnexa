{
  "name": "TripItem",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "flight",
        "stay",
        "place",
        "document"
      ]
    },
    "url": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "confirmation_number": {
      "type": "string"
    },
    "flight_number": {
      "type": "string"
    },
    "sort_order": {
      "type": "number"
    },
    "departure_airport": {
      "type": "string"
    },
    "arrival_airport": {
      "type": "string"
    },
    "departure_datetime": {
      "type": "string"
    },
    "arrival_datetime": {
      "type": "string"
    },
    "departure_timezone": {
      "type": "string"
    },
    "arrival_timezone": {
      "type": "string"
    },
    "booking_status": {
      "type": "string",
      "enum": [
        "confirmed",
        "unconfirmed",
        "estimated",
        "unknown"
      ]
    },
    "address": {
      "type": "string"
    },
    "place_id": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "priority": {
      "type": "string",
      "enum": [
        "mandatory",
        "preferred",
        "suggestion",
        "excluded"
      ]
    },
    "visit_duration_min": {
      "type": "number"
    },
    "ticket_type": {
      "type": "string",
      "enum": [
        "none",
        "entry",
        "guided_tour",
        "zone",
        "package"
      ]
    },
    "ticket_purchased": {
      "type": "boolean"
    },
    "entry_time": {
      "type": "string"
    },
    "indoor_outdoor": {
      "type": "string",
      "enum": [
        "indoor",
        "outdoor",
        "both",
        "unknown"
      ]
    },
    "check_in_time": {
      "type": "string"
    },
    "check_out_time": {
      "type": "string"
    },
    "stay_status": {
      "type": "string",
      "enum": [
        "booked",
        "chosen",
        "unconfirmed"
      ]
    },
    "source_status": {
      "type": "string",
      "enum": [
        "confirmed_by_user",
        "confirmed_by_document",
        "api_provided",
        "estimated",
        "unknown",
        "expired",
        "conflicting"
      ]
    },
    "verified_at": {
      "type": "string"
    },
    "completeness_note": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}