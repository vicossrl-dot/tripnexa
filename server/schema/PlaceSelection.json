{
  "name": "PlaceSelection",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string"
    },
    "trip_item_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "mandatory",
        "preferred",
        "suggestion",
        "excluded"
      ]
    },
    "desired_duration_min": {
      "type": "number"
    },
    "fixed_date": {
      "type": "string",
      "format": "date"
    },
    "fixed_time": {
      "type": "string"
    },
    "indoor_outdoor": {
      "type": "string",
      "enum": [
        "indoor",
        "outdoor",
        "both",
        "unknown"
      ]
    },
    "ticket_type": {
      "type": "string",
      "enum": [
        "none",
        "entry",
        "guided_tour",
        "zone",
        "package"
      ]
    },
    "ticket_purchased": {
      "type": "boolean"
    },
    "entry_time": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "place_id": {
      "type": "string"
    },
    "city": { "type": "string" },
    "country": { "type": "string" },
    "lat": { "type": "number" },
    "lng": { "type": "number" },
    "category": { "type": "string" },
    "area": { "type": "string" },
    "best_time_of_day": { "type": "string" },
    "selection_source": { "type": "string", "enum": ["manual", "google", "ai"] },
    "status": {
      "type": "string",
      "enum": [
        "unresolved",
        "resolved",
        "scheduled",
        "conflict",
        "unavailable"
      ]
    },
    "estimated_cost": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "fit_reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "trip_id",
    "name"
  ]
}
